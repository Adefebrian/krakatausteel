{
  "name": "krakatausteel",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "test": "bun test",
    "test:fresh": "bun run db:reset && bun test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "verify": "bun tools/verify.ts",
    "check:boundaries": "bun tools/check-boundaries.ts",
    "check:compose": "bun tools/check-compose.ts",
    "migrate": "bun tools/migrate.ts",
    "db:migrate": "bun tools/db.ts migrate",
    "db:migrate:test": "bun tools/db.ts migrate:test",
    "db:reset": "bun tools/db.ts reset",
    "db:seed": "bun tools/db.ts seed",
    "db:seed:dev": "bun tools/db.ts seed:dev",
    "db:seed:demo": "bun apps/api/src/seed/cli-demo.ts",
    "db:seed:demo:dev": "bun apps/api/src/seed/cli-demo.ts --dev",
    "db:status": "bun tools/db.ts status"
  },
  "dependencies": {
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/pg": "^8.11.0",
    "turbo": "^2.5.0",
    "typescript": "^5.7.0"
  }
}
