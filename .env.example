# Copy to .env and fill in real values. .env is gitignored and never committed.
#
#   cp .env.example .env
#
# Every key the app (packages/config env schema) and the production compose
# file (infra/docker-compose.prod.yml) reference is listed here, so a fresh
# clone is never missing one. Values here are local defaults or empty; no real
# secret ever belongs in this file. tools/check-compose.ts enforces both of
# those properties, and `bun run verify` runs it.

# ---------------------------------------------------------------------------
# Local development (native Postgres 15 and Redis, no Docker needed)
# ---------------------------------------------------------------------------
PORT=3001
WEB_PORT=3000

# Dev database. Homebrew Postgres has no password and uses your OS user, so a
# bare host URL works: postgres://localhost:5432/tjsl_dev
DATABASE_URL=postgres://localhost:5432/tjsl_dev

# Test database. MUST be a different database from DATABASE_URL and its name
# MUST end in _test: `bun run db:reset` drops and recreates its schema on every
# run, and tools/db.ts refuses to touch anything not ending in _test.
#   createdb tjsl_test
TEST_DATABASE_URL=postgres://localhost:5432/tjsl_test

REDIS_URL=redis://localhost:6379

# Local uploads go through the storage port to local disk; MinIO only exists in
# the server stack. Leave the credentials empty locally.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=tjsl-dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# AI layer is off until Fase 8 (docs/BUILD-PLAN.md). Model, when enabled, is
# gpt-4o-mini and nothing else.
AI_ENABLED=false
OPENAI_API_KEY=

CORS_ORIGINS=http://localhost:3000

# Reverse proxies in front of the API, counted from the socket inwards.
# 0 (the default) means X-Forwarded-For is IGNORED and the socket address is
# used: the only safe default, because a client can forge that header and both
# the rate limiter and audit_log.ip depend on getting the real address.
# Local dev has no proxy, so 0. The server stack has one Caddy, so 1 (set in
# infra/docker-compose.prod.yml). See apps/api/src/core/client-ip.ts.
TRUSTED_PROXY_COUNT=0
# Optional alternative for a variable-depth topology (a CDN in front of Caddy):
# comma-separated CIDR blocks that are our own infrastructure.
TRUSTED_PROXY_CIDRS=

# ---------------------------------------------------------------------------
# Server-side PDF export (OPTIONAL, and off by default on purpose)
# ---------------------------------------------------------------------------
# Absolute path to a Chromium or Chrome binary. EMPTY means this host produces
# no server-side PDF: `GET /laporan/ekspor/:kode?format=pdf` answers 503 with a
# message telling the operator to use `?format=html` and print it from their own
# browser, and `?format=xlsx` and `?format=html` work regardless.
#
# There is deliberately no auto-discovery (see
# apps/api/src/core/adapters/pdf-chromium.ts): a browser that happens to be
# installed on a developer laptop must not make the API behave differently there
# than on the server. Setting this starts a real browser subprocess inside the
# API, so it is a decision per host, and the image must actually contain one.
#   macOS dev: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
#   Debian:    /usr/bin/chromium
CHROMIUM_PATH=

# NO SESSION SIGNING KEY EXISTS, ON PURPOSE.
# Sessions are server side: the cookie carries an opaque 256-bit random id and
# the record lives in Redis (apps/api/src/modules/auth/session.ts), so there is
# nothing to sign and nothing to verify. A SESSION_SECRET used to be declared
# here and in the compose file while no code read it, which is worse than
# having none: it reads like a protection that is in place. If a future feature
# genuinely needs signed state, add the key here AND the code that uses it in
# the same change.

# ---------------------------------------------------------------------------
# Production only (server .env.prod, see infra/DEPLOY.md)
#
# These are read by infra/docker-compose.prod.yml, not by local dev. Keep them
# here so `.env.prod` can be created by copying this file on the server and
# filling in the blanks. Leave them empty in local .env.
# ---------------------------------------------------------------------------

# Public domain, no scheme, e.g. tjsl.example.com. Caddy issues TLS for it.
APP_DOMAIN=

# Postgres container credentials. Password: openssl rand -hex 24
POSTGRES_USER=tjsl
POSTGRES_PASSWORD=
POSTGRES_DB=tjsl

# MinIO root credentials; the API uses them as its S3 access key pair.
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
